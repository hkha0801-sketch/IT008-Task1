<Window x:Class="Quanlisinhvien.wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quanlisinhvien.wpf"
        Width="800"
        Height="450"
        Title="MainWindow"
        mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="29*"/>
            <ColumnDefinition Width="11*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Width="140"
             Height="20"
            
             HorizontalAlignment="Left"
             VerticalAlignment="Top"
             Text="THÔNG TIN SINH VIÊN"
             TextAlignment="Center" Margin="330,52,0,0" />
        <TextBox Width="396"
           Height="24"
           VerticalAlignment="Top"
           Background="LightGray"
           Foreground="Red" 
           Margin="252,141,152,0" Grid.ColumnSpan="2" TextChanged="TextBox_TextChanged_5" 
            />
        <TextBlock Width="94"
             Margin="158,141,0,269"
             HorizontalAlignment="Left"
             Text="Họ tên sinh viên: "
             TextAlignment="Left"
              />
        <TextBox Width="396"
           Height="24"
           Margin="252,180,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Background="LightGray"
           BorderBrush="Black"
           Foreground="Red" Grid.ColumnSpan="2"
           />
        <TextBlock Width="89"
             Margin="158,183,0,233"
             HorizontalAlignment="Left"
             Text="Mã số sinh viên:"
             TextAlignment="Left"
             />
        <TextBox Width="396"
           Height="24"
           Margin="252,220,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Background="LightGray"
           BorderBrush="Black"
           Foreground="Red"
           Grid.Column="0"
           Grid.Row="0" Grid.ColumnSpan="2" />
        <TextBlock Width="44"
             Margin="158,217,0,196"
             HorizontalAlignment="Left"
             RenderTransformOrigin="0.5,0.5"
             Text="Trường:"
             TextAlignment="Left"
             Grid.Column="0"
             Grid.Row="0" />
    </Grid>
</Window>