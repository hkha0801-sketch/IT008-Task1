<Window x:Class="Quanlisinhvien.wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Quanlisinhvien.wpf"
        Width="800"
        Height="450"
        Title="MainWindow"
        mc:Ignorable="d">
	<Grid>
		<TextBox Width="270"
             Height="55"
             Margin="0,42,250,0"
             HorizontalAlignment="Right"
             VerticalAlignment="Top"
             VerticalContentAlignment="Center"
             Text="THÔNG TIN SINH VIÊN"
             TextAlignment="Center"
             TextWrapping="WrapWithOverflow"
             Grid.Column="0"
             Grid.Row="0" />
		<Label Width="396"
           Height="24"
           Margin="252,141,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Background="LightGray"
           BorderBrush="Black"
           Foreground="Red"
           Grid.Column="0"
           Grid.Row="0" Content="adasdda&#xD;&#xA;" />
		<TextBox Width="89"
             Margin="158,141,0,269"
             HorizontalAlignment="Left"
             VerticalContentAlignment="Bottom"
             BorderBrush="{x:Null}"
             Text="Họ tên sinh viên: "
             TextAlignment="Left"
             Grid.Column="0"
             Grid.Row="0" TextChanged="TextBox_TextChanged" />
		<Label Width="396"
           Height="24"
           Margin="252,180,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Background="LightGray"
           BorderBrush="Black"
           Foreground="Red"
           Grid.Column="0"
           Grid.Row="0" Content="adadadsda" />
		<TextBox Width="89"
             Margin="158,183,0,233"
             HorizontalAlignment="Left"
             VerticalContentAlignment="Bottom"
             BorderBrush="{x:Null}"
             Text="Mã số sinh viên:"
             TextAlignment="Left"
             Grid.Column="0"
             Grid.Row="0" />
		<Label Width="396"
           Height="24"
           Margin="252,220,0,0"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Background="LightGray"
           BorderBrush="Black"
           Foreground="Red"
           Grid.Column="0"
           Grid.Row="0" Content="asdadassadsadasda" />
		<TextBox Width="44"
             Margin="158,217,0,196"
             HorizontalAlignment="Left"
             VerticalContentAlignment="Bottom"
             BorderBrush="{x:Null}"
             RenderTransformOrigin="0.5,0.5"
             Text="Trường:"
             TextAlignment="Left"
             Grid.Column="0"
             Grid.Row="0" />
	</Grid>
</Window>